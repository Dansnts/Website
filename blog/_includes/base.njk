<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} — Dani Faria dos Santos</title>
  <meta name="description" content="{{ description or title }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geomini:wght@300;400;500;600;700&family=Cascadia+Code:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css?v=128" />
  <link rel="icon" href="/favicon.ico" />
  <style>
    /* ── Blog listing ── */
    .blog-index-wrap { max-width: 760px; margin: 0 auto; padding: 0 2rem 5rem; }
    .post-list { list-style: none; padding: 0; margin-top: 1.5rem; }
    .post-list li { padding: 1.4rem 0; border-bottom: 1px solid var(--border); }
    .post-list li:first-child { border-top: 1px solid var(--border); }
    .post-date { font-family: var(--mono); font-size: 0.68rem; color: var(--subtle); letter-spacing: 0.06em; margin-bottom: 0.3rem; }
    .post-list a { font-size: 1.05rem; font-weight: 600; color: var(--text); text-decoration: none; transition: color var(--t); }
    .post-list a:hover { color: var(--accent); }
    .post-desc { font-size: 0.875rem; color: var(--muted); margin-top: 0.25rem; line-height: 1.6; font-weight: 300; }

    /* ── Blog post body (Markdown output inside .project-detail) ── */
    .blog-body { padding-bottom: 5rem; }

    .blog-body h2 {
      font-family: var(--mono);
      font-size: 0.85rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted);
      margin: 2.5rem 0 1rem;
    }
    .blog-body h3 {
      font-family: var(--sans);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--subtle);
      margin: 1.75rem 0 0.5rem;
    }
    .blog-body p {
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 300;
      color: var(--subtle);
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .blog-body ul, .blog-body ol {
      padding-left: 1.4rem;
      margin-bottom: 1rem;
      color: var(--subtle);
    }
    .blog-body li {
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 300;
      line-height: 1.75;
      margin-bottom: 0.25rem;
    }
    .blog-body a { color: var(--accent); }
    .blog-body a:hover { opacity: 0.75; }
    .blog-body strong { color: var(--text); font-weight: 600; }
    .blog-body em { color: var(--subtle); font-style: italic; }
    /* Inline code only - scoped to prose contexts so it never matches
       the <code> inside a <pre> (that one is a .code-block, styled by
       style.css, and must stay plain text with no pill background). */
    .blog-body p code, .blog-body li code, .blog-body td code, .blog-body blockquote code {
      font-family: var(--code);
      font-size: 0.8em;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 0.15em 0.4em;
      border-radius: 4px;
      color: var(--accent);
    }
    .blog-body blockquote {
      border-left: 2px solid var(--accent);
      padding: 0.1rem 1rem;
      color: var(--muted);
      margin: 1.5rem 0;
    }
    .blog-body hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }
    .blog-body img { max-width: 100%; border-radius: 8px; margin: 1rem 0; }
    .blog-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-family: var(--sans);
      font-size: 0.82rem;
      overflow-x: auto;
      display: block;
    }
    .blog-body thead tr { border-bottom: 1px solid var(--border-hi); }
    .blog-body th {
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      padding: 0 1rem;
      text-align: left;
    }
    .blog-body td {
      padding: 0.6rem 1rem;
      color: var(--subtle);
      font-weight: 300;
      line-height: 1.6;
      border-bottom: 1px solid var(--border);
    }
    .blog-body tr:last-child td { border-bottom: none; }
    .blog-body tbody tr:hover td { background: var(--surface); }

    /* ── Code blocks ──
       Markdown code fences get wrapped in .code-block by the script
       below, at which point .code-block/.code-header/.code-filename/
       .code-dots/.code-copy and their dark-theme variants all come
       from style.css - the same terminal-style chrome the rest of the
       site's hand-authored code blocks use, not redeclared here. */
  </style>
</head>
<body class="framed">
  <div id="site-header"></div>
  <div class="frame">
  <main>
    {{ content | safe }}
  </main>
  <div id="site-footer"></div>
  </div>
  <script src="/js/i18n.js?v=7"></script>
  <script src="/js/main.js?v=25"></script>
  <script>
    // Wraps each markdown-generated <pre> in the same .code-block
    // chrome the hand-authored project pages use (see copyCode in
    // main.js, loaded above, for the shared copy-button behavior).
    document.querySelectorAll('.blog-body pre').forEach(pre => {
      const code = pre.querySelector('code');
      const lang = (code && code.className.match(/language-(\w+)/)?.[1]) || '';
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      const header = document.createElement('div');
      header.className = 'code-header';
      header.innerHTML = `<span class="code-filename"><span class="code-dots"><span></span><span></span><span></span></span>${lang || 'code'}</span><button class="code-copy" onclick="copyCode(this)">Copier</button>`;
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(header);
      wrap.appendChild(pre);
    });
  </script>
</body>
</html>
